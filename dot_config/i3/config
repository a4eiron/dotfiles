set $mod Mod4

# navigation keys
set $left  h
set $down  j
set $up    k
set $right l

# workspace Names
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

# fonts
font pango:JetBrainsMono Nerd Font Mono 8

gaps inner 0
gaps outer 0

# xdg autostart (.desktop files)
exec --no-startup-id dex --autostart --environment i3

# display / monitor layout
exec --no-startup-id ~/.screenlayout/monitor.sh

# screen locker
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id xset s 480 dpms 600 600 600

# execs
exec --no-startup-id picom
exec --no-startup-id nm-applet
exec --no-startup-id xfce4-clipman
exec --no-startup-id /usr/bin/dunst
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# wallpaper
exec --no-startup-id sleep 1 && feh --bg-fill ~/Downloads/arch.png

# mouse+$mod to drag floating windows
floating_modifier $mod

tiling_drag modifier titlebar

# border
for_window [class="^.*"] border pixel 2

# Float standard desktop utilities and popups
for_window [class="?"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [class="Polkit-gnome-authentication-agent-1"] floating enable, move position center
for_window [class="Arandr"] floating enable
for_window [class="pavucontrol"] floating enable
for_window [class="kamoso"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Xfce4-clipman-his"] floating enable
for_window [class="Nwg-look"] floating enable
for_window [class="Nvidia-settings"] floating enable
for_window [class="Thunar"] floating enable
for_window [class="gwenview"] floating enable
for_window [class="okular"] floating enable
for_window [class="spectacle"] floating enable
for_window [class="vlc"] floating enable

bindsym $mod+g floating enable, resize set 1400 px 900 px, move position center

# terminals and launchers
bindsym $mod+Return exec kitty

bindsym $mod+d exec --no-startup-id rofi -modi drun -show drun \
			-config ~/.config/rofi/rofidmenu.rasi

bindsym Mod1+Tab exec --no-startup-id rofi -show window \
			-config ~/.config/rofi/rofidmenu.rasi

bindsym $mod+Shift+p exec --no-startup-id ~/.config/i3/scripts/powermenu.sh

bindsym Print 		exec spectacle
bindsym $mod+Shift+v exec xfce4-clipman-history


# session
bindsym $mod+q        kill
bindsym $mod+Shift+c  reload
bindsym $mod+Shift+r  restart
bindsym $mod+Shift+e  exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# change focus
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# move focused window
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

# layout splits & fullscreen
bindsym $mod+b  split h
bindsym $mod+v  split v
bindsym $mod+f  fullscreen toggle

# container layout Styles
bindsym $mod+s  layout stacking
bindsym $mod+w  layout tabbed
bindsym $mod+e  layout toggle split

# floating toggle / focus Toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space       focus mode_toggle

# parent / child Focus
bindsym $mod+a  focus parent
#bindsym $mod+d focus child

# scratchpad Control
# bindsym $mod+Shift+minus move scratchpad
# bindsym $mod+minus       scratchpad show

# switch/iterate between workspaces
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

workspace_auto_back_and_forth yes

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# audio
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+1 i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -RTMIN+1 i3blocks
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+1 i3blocks
bindsym XF86AudioMicMute     exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# media
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# brightness
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl s +2%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl s 2%-


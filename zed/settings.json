{
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },

  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },

  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15.0,
  "ui_font_size": 15.0,

  "vim_mode": true,
  "relative_line_numbers": "enabled",

  "code_lens": "on",
  "format_on_save": "on",
  "soft_wrap": "editor_width",
  "cursor_blink": false,
  "confirm_quit": true,
  "disable_ai": true,

  "project_panel": {
    "dock": "left",
    "diagnostic_badges": true,
    "git_status_indicator": true,
  },

  "tabs": {
    "show_diagnostics": "all",
    "git_status": true,
    "file_icons": true,
  },

  "toolbar": {
    "agent_review": false,
    "breadcrumbs": false,
    "code_actions": false,
    "quick_actions": false,
    "selections_menu": false,
  },

  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
    },
  },

  "inlay_hints": {
    "enabled": true,
  },

  "terminal": {
    "cursor_shape": "bar",
    "font_size": 15,
  },
}

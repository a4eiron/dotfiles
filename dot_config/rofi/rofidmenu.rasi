configuration {
	show-icons: true;
}

window {
	width: 650px;
	padding: 0px;
	border: 0;
}

mainbox {
	border: 0;
	padding: 16px;
}

inputbar {
	spacing: 12px;
	padding: 12px 16px;
}

listview {
	padding: 12px;
	scrollbar: false;
	lines: 8;
}

element {
	padding: 8px;
}

element-icon {
	size: 24px;
}
